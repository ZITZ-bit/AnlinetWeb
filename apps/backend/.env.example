# Puerto en el que escucha el backend (Render provee PORT automáticamente)
PORT=3002

# URL de conexión a la base de datos PostgreSQL externa (obligatoria en producción)
# Ejemplo: postgresql://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL="postgresql://postgres@localhost:5432/anlinet"

# Secreto para firmar tokens JWT (obligatorio, cambiar en producción)
JWT_SECRET=cambiar-por-un-secreto-fuerte-y-aleatorio

# Orígenes permitidos para CORS, separados por coma (obligatorio en producción)
# Ejemplo: https://tu-app-frontend.onrender.com,https://www.tudominio.com
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Entorno de ejecución (opcional)
NODE_ENV=production
